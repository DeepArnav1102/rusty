[package]
name = "rusty"
version = "0.1.0"
edition = "2024"

[dependencies]
anyhow = "1.0.104"
clap = { version = "4", features = ["derive"] }
hex = "0.4.3"
sha2 = "0.11.0"
serde = { version = "1", features = ["derive"] }
serde_json = "1"
walkdir = "2.5.0"
reqwest = { version = "0.13.5", features = ["blocking", "json"] }
dirs = "6"
